---
import { invitation } from '../config/invitation';
import { formatCalendarDate } from '../lib/datetime';

const { host, event, venue, copy } = invitation;

const dateLabel = formatCalendarDate(event.dateISO);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero__inner">
    <p class="mil-label hero__codename">{copy.codename}</p>

    <h1 id="hero-title" class="hero__title phosphor-glow">{copy.operationTitle}</h1>

    <p class="hero__subtitle">{copy.heroSubtitle}</p>

    <dl class="hero__dossier">
      <div class="hero__row">
        <dt class="mil-label">Objetivo</dt>
        <dd class="hero__value">
          {host.fullName} «{host.nickname}» — {host.age} años
        </dd>
      </div>
      <div class="hero__row">
        <dt class="mil-label">Fecha</dt>
        <dd class="hero__value">{dateLabel}</dd>
      </div>
      <div class="hero__row">
        <dt class="mil-label">Hora</dt>
        <dd class="hero__value">
          {event.timeLabel} ({event.tzLabel}) · Duración estimada: {event.durationLabel}
        </dd>
      </div>
      <div class="hero__row">
        <dt class="mil-label">Punto de encuentro</dt>
        <dd class="hero__value">{venue.name} — {venue.address}, {venue.city}</dd>
      </div>
    </dl>

    <p class="hero__cue" aria-hidden="true">▼ Desplazate para ver el briefing</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-9);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 56rem;
  }

  .hero__codename {
    align-self: flex-start;
  }

  .hero__title {
    font-size: var(--step-4);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--phos);
  }

  .hero__subtitle {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--ink);
  }

  .hero__dossier {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
    margin-top: var(--space-4);
    padding: var(--space-5);
    background-color: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--phos-dim);
    border-radius: var(--radius);
  }

  .hero__row {
    display: grid;
    gap: var(--space-1);
  }

  .hero__value {
    margin: 0;
    color: var(--ink);
  }

  .hero__cue {
    margin-top: var(--space-6);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--olive);
  }

  @media (min-width: 48rem) {
    .hero__row {
      grid-template-columns: 12rem 1fr;
      gap: var(--space-4);
      align-items: baseline;
    }
  }
</style>
