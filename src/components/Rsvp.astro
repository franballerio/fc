---
import { invitation } from '../config/invitation';

const { rsvp, features } = invitation;

const rsvpEnabled = features.rsvp;
---

{
  rsvpEnabled && (
    <section class="rsvp" aria-labelledby="rsvp-title">
      <div class="shell rsvp__inner">
        <p class="mil-label">Canal de confirmación</p>
        <h2 id="rsvp-title" class="rsvp__title">Anunciate en el puesto de mando</h2>
        <p class="rsvp__intro">
          Confirmá tu asistencia antes de {rsvp.deadlineLabel}.{' '}
          {features.telegram
            ? 'Tu confirmación viaja al servidor del sitio y desde ahí le llega al anfitrión.'
            : 'Esta planilla se completa en tu navegador: no viaja a ningún servidor ni a ninguna base de datos.'}
        </p>

        <noscript>
          <p class="rsvp__noscript panel">
            {features.telegram
              ? 'Este formulario necesita JavaScript para enviar tu confirmación al anfitrión.'
              : 'Este formulario se resuelve en tu navegador, así que necesita JavaScript.'}{' '}
            Para confirmar, escribile a {rsvp.contactName} por{' '}
            <a href={rsvp.whatsappUrl} rel="noopener noreferrer">WhatsApp</a>, al teléfono{' '}
            {rsvp.contactPhone} o a {rsvp.contactEmail}, antes de {rsvp.deadlineLabel}.
          </p>
        </noscript>

        <form
          class="rsvp__form panel reveal"
          data-rsvp-form
          data-rsvp-telegram={features.telegram ? 'true' : 'false'}
          data-rsvp-state="idle"
          novalidate
        >
          <div class="rsvp__errors" data-rsvp-errors role="alert" tabindex="-1" hidden>
            <p class="rsvp__errors-title">Revisá estos datos antes de enviar:</p>
            <ul class="rsvp__errors-list">
              <li data-rsvp-error-summary="name" hidden>
                <a href="#rsvp-name">Poné tu nombre y apellido.</a>
              </li>
              <li data-rsvp-error-summary="drinks" hidden>
                <a href="#rsvp-drinks">Contá qué vas a traer para tomar.</a>
              </li>
              <li data-rsvp-error-summary="contact" hidden>
                <a href="#rsvp-contact">Dejá un teléfono o un email de contacto.</a>
              </li>
              <li data-rsvp-error-summary="attend" hidden>
                <a href="#rsvp-attend">Marcá la casilla para confirmar que venís.</a>
              </li>
            </ul>
          </div>

          <div class="rsvp__field">
            <label class="rsvp__label" for="rsvp-name">Nombre y apellido</label>
            <input
              class="rsvp__input"
              id="rsvp-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              aria-describedby="rsvp-name-error"
            />
            <p class="rsvp__error" id="rsvp-name-error" data-rsvp-field-error="name" hidden>
              Poné tu nombre y apellido.
            </p>
          </div>

          <div class="rsvp__field">
            <label class="rsvp__label" for="rsvp-drinks">¿Qué vas a traer para tomar?</label>
            <input
              class="rsvp__input"
              id="rsvp-drinks"
              name="drinks"
              type="text"
              required
              autocomplete="off"
              maxlength="80"
              aria-describedby="rsvp-drinks-hint rsvp-drinks-error"
            />
            <p class="rsvp__hint" id="rsvp-drinks-hint">
              Así no se repiten las bebidas. Si todavía no sabés, podés poner "a definir".
            </p>
            <p class="rsvp__error" id="rsvp-drinks-error" data-rsvp-field-error="drinks" hidden>
              Contá qué vas a traer para tomar.
            </p>
          </div>

          <div class="rsvp__field">
            <label class="rsvp__label" for="rsvp-contact">Contacto</label>
            <input
              class="rsvp__input"
              id="rsvp-contact"
              name="contact"
              type="text"
              required
              aria-describedby="rsvp-contact-hint rsvp-contact-error"
            />
            <p class="rsvp__hint" id="rsvp-contact-hint">
              Teléfono o email, para ubicarte si cambia algo.
            </p>
            <p class="rsvp__error" id="rsvp-contact-error" data-rsvp-field-error="contact" hidden>
              Dejá un teléfono o un email de contacto.
            </p>
          </div>

          <div class="rsvp__field">
            <label class="rsvp__label" for="rsvp-message">Mensaje para el anfitrión</label>
            <textarea
              class="rsvp__input rsvp__textarea"
              id="rsvp-message"
              name="message"
              rows="3"
              aria-describedby="rsvp-message-hint"></textarea>
            <p class="rsvp__hint" id="rsvp-message-hint">Opcional. Va a leerlo el anfitrión.</p>
          </div>

          <div class="rsvp__field rsvp__field--check">
            <label class="rsvp__check-label" for="rsvp-attend">
              <input
                class="rsvp__check"
                id="rsvp-attend"
                name="attend"
                type="checkbox"
                required
                aria-describedby="rsvp-attend-error"
              />
              <span>Confirmo que voy a asistir.</span>
            </label>
            <p class="rsvp__error" id="rsvp-attend-error" data-rsvp-field-error="attend" hidden>
              Marcá la casilla para confirmar que venís.
            </p>
          </div>

          <!-- Honeypot: hidden from sight and from the accessibility tree, and
               outside the tab order. Only a naive bot fills it. -->
          <div class="rsvp__honeypot sr-only" aria-hidden="true">
            <label for="rsvp-website">No completar este campo</label>
            <input
              id="rsvp-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
              data-rsvp-honeypot
            />
          </div>

          <p class="rsvp__status" data-rsvp-status role="status" hidden></p>

          <button class="rsvp__submit" type="submit" data-rsvp-submit>Enviar confirmación</button>
        </form>

        <div
          class="rsvp__ack panel"
          data-rsvp-ack
          data-rsvp-ack-state="local"
          tabindex="-1"
          hidden
        >
          <p class="rsvp__ack-status phosphor-glow" data-rsvp-ack-status>OPERADOR REGISTRADO</p>
          <p class="rsvp__ack-name">
            <span class="rsvp__ack-value" data-rsvp-ack-name></span><span data-rsvp-ack-suffix
              > — asistencia confirmada.</span
            >
          </p>
          <p class="rsvp__ack-detail">Ventana de confirmación: {rsvp.deadlineLabel}</p>
          <p class="rsvp__ack-fallback">
            Si necesitás cambiarlo, avisale a {rsvp.contactName}:{' '}
            <a href={rsvp.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a> · teléfono{' '}
            {rsvp.contactPhone} · email {rsvp.contactEmail}
          </p>
          <button class="rsvp__edit" type="button" data-rsvp-edit>Editar respuesta</button>
        </div>
      </div>
    </section>
  )
}

<style>
  .rsvp {
    position: relative;
    padding-block: var(--space-8);
  }

  .rsvp__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rsvp__title {
    font-size: var(--step-2);
    color: var(--phos);
    text-transform: uppercase;
  }

  .rsvp__intro {
    max-width: var(--measure);
    color: var(--ink);
  }

  .rsvp__form {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
    padding: var(--space-5);
    border-left: 3px solid var(--phos-dim);
  }

  .rsvp__errors {
    padding: var(--space-4);
    border: 1px solid var(--alert);
    background-color: rgba(255, 176, 0, 0.08);
    color: var(--alert);
    font-size: var(--step--1);
  }

  .rsvp__errors-title {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rsvp__errors-list {
    margin-top: var(--space-2);
    padding-left: var(--space-5);
  }

  .rsvp__errors-list a {
    color: var(--alert);
  }

  .rsvp__field {
    display: grid;
    gap: var(--space-2);
  }

  .rsvp__label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--phos-dim);
  }

  .rsvp__input {
    width: 100%;
    max-width: 32rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background-color: var(--panel-strong);
    color: var(--ink);
    font: inherit;
  }

  .rsvp__textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .rsvp__input[aria-invalid='true'] {
    border-color: var(--alert);
  }

  .rsvp__hint {
    max-width: 32rem;
    font-size: var(--step--1);
    color: var(--olive);
  }

  .rsvp__error {
    max-width: 32rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--alert);
  }

  .rsvp__field--check {
    gap: var(--space-2);
  }

  .rsvp__check-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .rsvp__check {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    accent-color: var(--phos-dim);
  }

  .rsvp__submit,
  .rsvp__edit {
    justify-self: start;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background-color: var(--panel-strong);
    color: var(--phos);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .rsvp__submit:hover,
  .rsvp__edit:hover {
    background-color: var(--panel);
  }

  .rsvp__submit:disabled {
    cursor: progress;
    opacity: 0.65;
  }

  .rsvp__status {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--phos-dim);
  }

  .rsvp__ack {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-5);
    border-left: 3px solid var(--phos);
  }

  .rsvp__ack[data-rsvp-ack-state='fallback'] {
    border-left-color: var(--alert);
  }

  .rsvp__ack[data-rsvp-ack-state='fallback'] .rsvp__ack-status {
    color: var(--alert);
  }

  .rsvp__ack-status {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--phos);
  }

  .rsvp__ack-value {
    font-weight: 700;
    color: var(--khaki);
  }

  .rsvp__ack-detail,
  .rsvp__ack-fallback {
    font-size: var(--step--1);
    color: var(--ink-dim);
  }
  /*
   * Without JavaScript the acknowledgement cannot be rendered locally and a
   * plain submit would only bounce the answer back into the URL, so the form
   * steps aside for the contact route shown by the <noscript> block.
   */
  :global(html:not(.js)) .rsvp__form {
    display: none;
  }

  .rsvp__noscript {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
    font-size: var(--step-0);
  }

  .rsvp__noscript a {
    color: var(--phos);
  }
</style>

<script>
  type FieldName = 'name' | 'drinks' | 'contact' | 'attend';

  const FIELD_IDS: Record<FieldName, string> = {
    name: 'rsvp-name',
    drinks: 'rsvp-drinks',
    contact: 'rsvp-contact',
    attend: 'rsvp-attend',
  };

  const FIELD_NAMES: FieldName[] = ['name', 'drinks', 'contact', 'attend'];

  const REQUEST_TIMEOUT_MS = 10000;

  type AckState = 'local' | 'delivered' | 'fallback';

  /** Acknowledgement copy per outcome; the local text is unchanged by design. */
  const ACK_COPY: Record<AckState, { status: string; suffix: string; action: string }> = {
    local: {
      status: 'OPERADOR REGISTRADO',
      suffix: ' — asistencia confirmada.',
      action: 'Editar respuesta',
    },
    delivered: {
      status: 'TRANSMISIÓN ENTREGADA',
      suffix: ' — tu confirmación llegó al anfitrión.',
      action: 'Editar respuesta',
    },
    fallback: {
      status: 'TRANSMISIÓN INTERRUMPIDA',
      suffix: ' — no pudimos entregar tu confirmación al anfitrión.',
      action: 'Reintentar envío',
    },
  };

  interface RsvpPayload {
    name: string;
    drinks: string;
    contact: string;
    message: string;
    elapsedMs: number;
    honeypot: string;
  }

  interface RsvpHandle {
    destroy: () => void;
  }

  interface RsvpWindow extends Window {
    __rsvpFormHandle?: RsvpHandle;
  }

  function fieldNameForId(id: string): FieldName | null {
    const found = FIELD_NAMES.find((name) => FIELD_IDS[name] === id);
    return found ?? null;
  }

  function isInvalid(name: FieldName, control: HTMLInputElement): boolean {
    if (name === 'attend') {
      return !control.checked;
    }

    return control.value.trim() === '';
  }

  /** Wires validation, optional server delivery and the acknowledgement swap. */
  function initRsvpForm(): void {
    const host = window as RsvpWindow;
    host.__rsvpFormHandle?.destroy();
    host.__rsvpFormHandle = undefined;

    const maybeForm = document.querySelector<HTMLFormElement>('form[data-rsvp-form]');
    if (maybeForm === null) {
      return;
    }
    // Aliased to a non-nullable binding: TypeScript drops control-flow narrowing
    // of captured variables inside hoisted function declarations.
    const form: HTMLFormElement = maybeForm;

    const ack = document.querySelector<HTMLElement>('[data-rsvp-ack]');
    const ackStatus = document.querySelector<HTMLElement>('[data-rsvp-ack-status]');
    const ackName = document.querySelector<HTMLElement>('[data-rsvp-ack-name]');
    const ackSuffix = document.querySelector<HTMLElement>('[data-rsvp-ack-suffix]');
    const editButton = document.querySelector<HTMLButtonElement>('[data-rsvp-edit]');
    const summary = document.querySelector<HTMLElement>('[data-rsvp-errors]');
    const submitButton = document.querySelector<HTMLButtonElement>('[data-rsvp-submit]');
    const statusEl = document.querySelector<HTMLElement>('[data-rsvp-status]');
    const honeypot = document.querySelector<HTMLInputElement>('[data-rsvp-honeypot]');
    const messageControl = document.querySelector<HTMLTextAreaElement>('#rsvp-message');

    const telegramEnabled = form.dataset.rsvpTelegram === 'true';

    // First interaction drives `elapsedMs`; the earliest of focus, input,
    // pointer, key or change wins, and page load is the conservative fallback
    // for a submit that fires no interaction event at all (autofill).
    const pageLoadAt = Date.now();
    let firstInteractionAt: number | null = null;
    let submitting = false;

    function markInteraction(): void {
      if (firstInteractionAt === null) {
        firstInteractionAt = Date.now();
      }
    }

    function readControl(name: FieldName): HTMLInputElement | null {
      const node = document.getElementById(FIELD_IDS[name]);
      return node instanceof HTMLInputElement ? node : null;
    }

    const controls: Record<FieldName, HTMLInputElement | null> = {
      name: readControl('name'),
      drinks: readControl('drinks'),
      contact: readControl('contact'),
      attend: readControl('attend'),
    };

    function errorNode(name: FieldName): HTMLElement | null {
      return document.querySelector<HTMLElement>(`[data-rsvp-field-error="${name}"]`);
    }

    function summaryItem(name: FieldName): HTMLElement | null {
      return document.querySelector<HTMLElement>(`[data-rsvp-error-summary="${name}"]`);
    }

    let attempted = false;

    function paint(name: FieldName): boolean {
      const control = controls[name];
      const invalid = control !== null && attempted && isInvalid(name, control);

      if (control !== null) {
        control.setAttribute('aria-invalid', invalid ? 'true' : 'false');
      }

      const error = errorNode(name);
      if (error !== null) {
        error.hidden = !invalid;
      }

      const item = summaryItem(name);
      if (item !== null) {
        item.hidden = !invalid;
      }

      return invalid;
    }

    /** Repaints every field and returns the names that are still invalid. */
    function refresh(): FieldName[] {
      return FIELD_NAMES.filter((name) => paint(name));
    }

    function syncSummary(invalidNames: FieldName[]): void {
      if (summary !== null) {
        summary.hidden = invalidNames.length === 0;
      }
    }

    function guestName(): string {
      return controls.name === null ? '' : controls.name.value.trim();
    }

    function setAckState(state: AckState): void {
      const copy = ACK_COPY[state];
      if (ackStatus !== null) {
        ackStatus.textContent = copy.status;
      }
      if (ackSuffix !== null) {
        ackSuffix.textContent = copy.suffix;
      }
      if (editButton !== null) {
        editButton.textContent = copy.action;
      }
      if (ack !== null) {
        ack.dataset.rsvpAckState = state;
      }
    }

    function showAck(state: AckState, name: string): void {
      if (ack === null) {
        return;
      }

      setAckState(state);
      // Guest input is echoed as text, never as markup.
      if (ackName !== null) {
        ackName.textContent = name;
      }

      form.hidden = true;
      ack.hidden = false;
      ack.focus();
    }

    function setSending(sending: boolean): void {
      submitting = sending;
      form.dataset.rsvpState = sending ? 'sending' : 'idle';
      if (submitButton !== null) {
        submitButton.disabled = sending;
      }
      if (statusEl !== null) {
        statusEl.textContent = sending ? 'Transmitiendo confirmación…' : '';
        statusEl.hidden = !sending;
      }
    }

    function collectPayload(): RsvpPayload | null {
      const { name, drinks, contact } = controls;
      if (name === null || drinks === null || contact === null) {
        return null;
      }

      return {
        name: name.value.trim(),
        drinks: drinks.value.trim(),
        contact: contact.value.trim(),
        message: messageControl === null ? '' : messageControl.value.trim(),
        elapsedMs: Date.now() - (firstInteractionAt ?? pageLoadAt),
        honeypot: honeypot === null ? '' : honeypot.value,
      };
    }

    async function transmit(payload: RsvpPayload): Promise<boolean> {
      try {
        const response = await fetch('/api/rsvp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
        });

        if (!response.ok) {
          return false;
        }

        const body: unknown = await response.json();
        if (typeof body !== 'object' || body === null || !('ok' in body) || body.ok !== true) {
          return false;
        }

        // A silent drop answers 200 with `delivered: false`; an absent flag still
        // means the confirmation reached the host.
        return !('delivered' in body) || body.delivered !== false;
      } catch {
        // Network error, timeout or an unreadable body all mean: not delivered.
        return false;
      }
    }

    async function handleSubmit(event: Event): Promise<void> {
      event.preventDefault();
      if (submitting) {
        return;
      }

      attempted = true;

      const invalidNames = refresh();
      syncSummary(invalidNames);

      if (invalidNames.length > 0) {
        summary?.focus();
        return;
      }

      // Telegram disabled: keep today's local acknowledgement and send nothing.
      if (!telegramEnabled) {
        showAck('local', guestName());
        return;
      }

      const payload = collectPayload();
      if (payload === null) {
        showAck('fallback', guestName());
        return;
      }

      setSending(true);
      const delivered = await transmit(payload);
      setSending(false);
      showAck(delivered ? 'delivered' : 'fallback', payload.name);
    }

    function handleEdit(): void {
      if (ack === null) {
        return;
      }

      // The form is never reset, so the typed values come back untouched.
      ack.hidden = true;
      form.hidden = false;
      form.dataset.rsvpState = 'idle';
      controls.name?.focus();
    }

    function handleInput(event: Event): void {
      if (!attempted) {
        return;
      }

      const target = event.target;
      if (!(target instanceof HTMLInputElement)) {
        return;
      }

      const name = fieldNameForId(target.id);
      if (name === null) {
        return;
      }

      syncSummary(refresh());
    }

    function destroy(): void {
      form.removeEventListener('submit', handleSubmit);
      form.removeEventListener('input', handleInput);
      form.removeEventListener('input', markInteraction);
      form.removeEventListener('focusin', markInteraction);
      form.removeEventListener('pointerdown', markInteraction);
      form.removeEventListener('keydown', markInteraction);
      form.removeEventListener('change', markInteraction);
      editButton?.removeEventListener('click', handleEdit);
    }

    form.addEventListener('submit', handleSubmit);
    form.addEventListener('input', handleInput);
    form.addEventListener('input', markInteraction);
    form.addEventListener('focusin', markInteraction);
    form.addEventListener('pointerdown', markInteraction);
    form.addEventListener('keydown', markInteraction);
    form.addEventListener('change', markInteraction);
    editButton?.addEventListener('click', handleEdit);

    host.__rsvpFormHandle = { destroy };
  }

  initRsvpForm();
</script>
