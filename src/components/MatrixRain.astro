---
import { invitation } from '../config/invitation';

const matrixRainEnabled = invitation.features.matrixRain;
---

<canvas
  class="matrix-rain"
  data-matrix-rain
  data-enabled={String(matrixRainEnabled)}
  aria-hidden="true"
></canvas>

<script>
  import { initMatrixRain } from '../scripts/matrix-rain';

  initMatrixRain();
</script>

<style>
  /* Fixed background layer: never intercepts pointer events, never announced. */
  .matrix-rain {
    position: fixed;
    inset: 0;
    z-index: var(--z-rain);
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.55;
  }
</style>
