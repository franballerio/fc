---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MatrixRain from '../components/MatrixRain.astro';
import SelectedReveal from '../components/SelectedReveal.astro';
import Countdown from '../components/Countdown.astro';
import Briefing from '../components/Briefing.astro';
import Rsvp from '../components/Rsvp.astro';
import AudioToggle from '../components/AudioToggle.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RevealObserver from '../components/RevealObserver.astro';
---

<BaseLayout>
  <MatrixRain />

  {/* Section order: hero → decrypt reveal → countdown → briefing → RSVP. */}
  <main id="main">
    <Hero />
    <SelectedReveal />
    <Countdown />
    <Briefing />
    <Rsvp />
  </main>

  <AudioToggle />
  <SiteFooter />
  <RevealObserver />
</BaseLayout>
