---
import { invitation } from '../config/invitation';

const { event, features } = invitation;

const countdownEnabled = features.countdown;

/**
 * The ISO string carries its own numeric offset, so the calendar date is read
 * from the literal text instead of being parsed with the build machine zone.
 */
function formatEventDate(iso: string): string {
  const [datePart = ''] = iso.split('T');
  const [yearText = '', monthText = '', dayText = ''] = datePart.split('-');

  const year = Number.parseInt(yearText, 10);
  const month = Number.parseInt(monthText, 10);
  const day = Number.parseInt(dayText, 10);

  if ([year, month, day].some((value) => !Number.isFinite(value))) {
    return iso;
  }

  return new Intl.DateTimeFormat('es-AR', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(Date.UTC(year, month - 1, day));
}

const eventDateLabel = formatEventDate(event.dateISO);

// Static sentence: the only countdown text assistive technology ever receives.
const countdownSummary = `La cita es el ${eventDateLabel} a las ${event.timeLabel} (${event.tzLabel}), con una duración estimada de ${event.durationLabel}.`;
---

{
  countdownEnabled && (
    <section
      class="countdown"
      aria-labelledby="countdown-title"
      data-countdown
      data-countdown-target={event.dateISO}
    >
      <div class="shell countdown__inner">
        <p class="mil-label">Cuenta regresiva</p>
        <h2 id="countdown-title" class="countdown__title">Tiempo restante para el operativo</h2>

        <div class="countdown__board panel reveal" data-countdown-board>
          {/* Decorative counters: the readable sentence below carries the date. */}
          <div class="countdown__units" aria-hidden="true">
            <div class="countdown__unit">
              <span class="countdown__value" data-countdown-unit="days">00</span>
              <span class="countdown__unit-label">Días</span>
            </div>
            <div class="countdown__unit">
              <span class="countdown__value" data-countdown-unit="hours">00</span>
              <span class="countdown__unit-label">Horas</span>
            </div>
            <div class="countdown__unit">
              <span class="countdown__value" data-countdown-unit="minutes">00</span>
              <span class="countdown__unit-label">Minutos</span>
            </div>
            <div class="countdown__unit">
              <span class="countdown__value" data-countdown-unit="seconds">00</span>
              <span class="countdown__unit-label">Segundos</span>
            </div>
          </div>

          <p class="countdown__meta" aria-hidden="true">
            Inicio {event.timeLabel} · {event.tzLabel} · Duración {event.durationLabel}
          </p>

          <p class="countdown__finished" data-countdown-finished hidden></p>
        </div>

        <p class="sr-only">{countdownSummary}</p>
      </div>
    </section>
  )
}

<style>
  .countdown {
    position: relative;
    padding-block: var(--space-8);
  }

  .countdown__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .countdown__title {
    font-size: var(--step-2);
    color: var(--phos);
    text-transform: uppercase;
  }

  .countdown__board {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
    border-left: 3px solid var(--phos-dim);
  }

  .countdown__units {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    background-color: var(--panel-strong);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .countdown__value {
    font-size: var(--step-3);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--phos);
    text-shadow: 0 0 0.4em var(--phos-glow);
  }

  .countdown__unit-label {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--phos-dim);
  }

  .countdown__meta {
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .countdown__finished {
    font-size: var(--step-1);
    color: var(--alert);
  }

  /* Past or unparseable target: the counters are replaced by one neutral line. */
  .countdown__board.is-finished .countdown__units,
  .countdown__board.is-finished .countdown__meta {
    display: none;
  }

  @media (min-width: 48rem) {
    .countdown__units {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { initCountdown } from '../scripts/countdown';

  initCountdown();
</script>
